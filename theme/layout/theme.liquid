<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background | default: '#EEF1EF' }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.remove('no-js');
      window.themeSettings = {
        animations: {{ settings.animations_enabled | json }},
        cartDrawer: {{ settings.cart_drawer_enabled | json }},
        stickyAtc: {{ settings.sticky_atc_enabled | json }}
      };
      window.themeMoneyFormat = {{ shop.money_format | json }};
      window.themeStrings = { cartEmpty: {{ settings.cart_empty_message | json }} };
      window.routes = {
        cartAddUrl: '{{ routes.cart_add_url }}.js',
        cartUrl: '{{ routes.cart_url }}',
        cartChangeUrl: '{{ routes.cart_change_url }}.js'
      };
    </script>
    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">Aller au contenu</a>
    {% sections 'header-group' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    {% if settings.cart_drawer_enabled %}{% render 'cart-drawer' %}{% endif %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
