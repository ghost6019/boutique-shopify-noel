<section class="section" id="produit">
  <div class="page-width">
    <div class="showcase{% if section.settings.flip %} showcase--flip{% endif %}">
      <div class="showcase__image" data-animate="left">
        {%- if section.settings.image != blank -%}
          {% render 'image', image: section.settings.image, sizes: '(min-width: 900px) 50vw, 100vw' %}
        {%- else -%}
          {{ 'product-demo.jpg' | asset_url | image_tag: loading: 'lazy', alt: section.settings.title }}
        {%- endif -%}
        {%- if section.settings.badge != blank -%}
          <span class="showcase__badge">{{ section.settings.badge }}</span>
        {%- endif -%}
      </div>

      <div class="showcase__copy" data-animate>
        {% render 'section-header',
          eyebrow: section.settings.eyebrow,
          title: section.settings.title,
          index: '02'
        %}

        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="benefit-list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'icon', name: 'check', size: 22 %}
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <a class="btn" href="{{ section.settings.cta_link | default: '#offre' }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Présentation du produit",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image du produit" },
    { "type": "text", "id": "badge", "label": "Badge sur l'image", "default": "Édition Noël" },
    { "type": "checkbox", "id": "flip", "label": "Inverser image et texte", "default": false },
    { "type": "header", "content": "Contenu" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre projecteur" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Un seul geste, une ambiance de rêve" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Posez-le, branchez-le en USB, et laissez la lumière faire le reste. Une ambiance festive pour le salon, le sapin, ou une soirée de Noël.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "Texte du bouton", "default": "Je veux le mien !" },
    { "type": "text", "id": "cta_link", "label": "Lien du bouton", "default": "#offre" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point fort",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Installation en quelques minutes, sans outil" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Présentation du produit",
      "blocks": [
        { "type": "point", "settings": { "text": "Installation en quelques minutes, sans outil" } },
        { "type": "point", "settings": { "text": "Une lumière festive pour toute la maison" } },
        { "type": "point", "settings": { "text": "Un cadeau qui fait briller tous les yeux" } }
      ]
    }
  ]
}
{% endschema %}
