{{ 'sections.css' | asset_url | stylesheet_tag }}

<section class="page-main">
  <div class="page-width">
    <header class="section__header">
      <h1 class="section__title section__title--wide">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="section__subtitle rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size == 0 -%}
        <p class="empty-state">Aucun produit dans cette collection pour le moment.</p>
      {%- else -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a class="btn btn--ghost" href="{{ paginate.previous.url }}">← Précédent</a>
          {%- endif -%}
          <span class="pagination__current">Page {{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}
            <a class="btn btn--ghost" href="{{ paginate.next.url }}">Suivant →</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Produits par page", "min": 4, "max": 24, "step": 4, "default": 12 }
  ]
}
{% endschema %}
