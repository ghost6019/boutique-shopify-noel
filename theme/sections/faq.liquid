<section class="section" id="faq">
  <div class="page-width page-width--narrow">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      subtitle: section.settings.subtitle,
      center: true,
      wide: true,
      index: '08'
    %}

    {%- if section.blocks.size > 0 -%}
      <div class="faq" data-animate>
        {%- for block in section.blocks -%}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.question }}</span>
              <span class="faq-item__icon">{% render 'icon', name: 'plus', size: 16 %}</span>
            </summary>
            <div class="faq-item__body rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>

      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for block in section.blocks -%}
              {
                "@type": "Question",
                "name": {{ block.settings.question | strip_html | json }},
                "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .faq-item summary{text-align:left}
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Questions fréquentes" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Vous vous demandez…" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Les réponses aux questions les plus posées." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Comment fonctionne le projecteur ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Le projecteur diffuse une lumière festive pour créer une ambiance de Noël. Branchez-le en USB, placez-le, et profitez.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Comment fonctionne le projecteur ?", "answer": "<p>Le projecteur diffuse une lumière festive destinée à créer une ambiance de Noël dans votre intérieur.</p>" } },
        { "type": "question", "settings": { "question": "Comment l’alimenter ?", "answer": "<p>Via une connexion USB.</p>" } },
        { "type": "question", "settings": { "question": "Où puis-je l’utiliser ?", "answer": "<p>Utilisation intérieure : salon, autour du sapin, chambre, soirée de Noël.</p>" } },
        { "type": "question", "settings": { "question": "Est-il facile à installer ?", "answer": "<p>Oui. Branchez en USB, placez-le, c’est prêt.</p>" } },
        { "type": "question", "settings": { "question": "Quels sont les délais de livraison ?", "answer": "<p>Les délais dépendent de votre adresse. Consultez la page Livraison pour les informations à jour.</p>" } },
        { "type": "question", "settings": { "question": "Quelle est la politique de retour ?", "answer": "<p>Les conditions sont détaillées dans vos pages Retours et Politique de remboursement.</p>" } }
      ]
    }
  ]
}
{% endschema %}
