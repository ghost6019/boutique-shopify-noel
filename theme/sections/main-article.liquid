{{ 'sections.css' | asset_url | stylesheet_tag }}

<article class="page-main">
  <div class="page-width page-width--narrow">
    <header class="section__header">
      <p class="blog-date">
        {{ article.published_at | time_tag: format: 'date' }}
        {%- if article.author != blank %} · {{ article.author }}{% endif -%}
      </p>
      <h1 class="section__title section__title--wide">{{ article.title }}</h1>
    </header>

    {%- if article.image != blank -%}
      <div class="media article__image">
        {% render 'image', image: article.image, sizes: '(min-width: 750px) 720px, 100vw', loading: 'eager' %}
      </div>
    {%- endif -%}

    <div class="rte article__content">{{ article.content }}</div>

    <p class="article__back"><a href="{{ blog.url }}">← Retour au blog</a></p>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
