<section class="password-page">
  <div class="password-page__inner">
    <p class="brand">{{ settings.brand_name | default: shop.name }}</p>
    <h1 class="password-page__title">{{ section.settings.title }}</h1>
    <p class="password-page__text">
      {%- if shop.password_message != blank -%}
        {{ shop.password_message }}
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>

    {%- form 'storefront_password', class: 'password-page__form' -%}
      {%- if form.errors -%}
        <p class="password-page__error" role="alert">Mot de passe incorrect. Veuillez réessayer.</p>
      {%- endif -%}
      <label class="visually-hidden" for="Password">Mot de passe</label>
      <input class="field__input" type="password" name="password" id="Password" placeholder="Mot de passe" autocomplete="current-password" required>
      <button type="submit" class="btn btn--full">Entrer</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Page de mot de passe",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Ouverture bientôt" },
    { "type": "textarea", "id": "text", "label": "Texte (si aucun message n'est défini dans Shopify)", "default": "Notre boutique de Noël ouvre très prochainement. Revenez vite !" }
  ]
}
{% endschema %}
