{%- if section.blocks.size > 0 -%}
  <div class="announcement announcement--marquee" role="region" aria-label="Annonces">
    <div class="announcement__track">
      {%- for i in (1..4) -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <span class="announcement__item" {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
              {%- if block.settings.link != blank and i == 1 -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonces",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Projecteur LED · ambiance de Noël" },
        { "type": "url", "id": "link", "label": "Lien (optionnel)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonces",
      "blocks": [
        { "type": "message", "settings": { "text": "Projecteur LED · ambiance de Noël" } },
        { "type": "message", "settings": { "text": "Retours simples" } },
        { "type": "message", "settings": { "text": "Paiement sécurisé" } }
      ]
    }
  ]
}
{% endschema %}
