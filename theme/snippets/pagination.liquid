{%- comment -%}
  Pagination accessible.
  Paramètre : paginate (objet paginate obligatoire)
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="nf-pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="nf-pagination__list">
      {%- if paginate.previous -%}
        <li><a class="nf-pagination__link" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">&larr;</a></li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="nf-pagination__link" href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="nf-pagination__link is-current" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span class="nf-pagination__link is-gap">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li><a class="nf-pagination__link" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">&rarr;</a></li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
