{%- comment -%}
  Icônes SVG en ligne.
  Paramètres :
    - name  : truck, return, shield, lock, gift, star, heart, check, cart, menu, close, search, user, plus, minus, arrow, chevron, play, sparkle, mail, message, instagram, tiktok, facebook, pinterest, youtube
    - size  : taille en px (défaut 24)
    - class : classes additionnelles
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 24
-%}
<svg
  class="nf-icon nf-icon--{{ name }}{% if class != blank %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M2 6.5h11v10H2z"/><path d="M13 10h4.5l3.5 3.5v3H13z"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
    {%- when 'return' -%}
      <path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5 4 9l4 4"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v5.5c0 4.5 3.2 8 7.5 9.5 4.3-1.5 7.5-5 7.5-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="9" width="17" height="4" rx="1"/><path d="M5 13v7.5h14V13"/><path d="M12 9v11.5"/><path d="M12 9c-1-4-5.5-4.5-5.5-1.8C6.5 8.5 8 9 12 9zm0 0c1-4 5.5-4.5 5.5-1.8C17.5 8.5 16 9 12 9z"/>
    {%- when 'star' -%}
      <path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.9 6.8 19.7l1-5.9-4.3-4.1 5.9-.8z"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'cart' -%}
      <path d="M3 4h2.5l2.2 11h10.6L20.5 7.5H6.2"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}
      <path d="m6 6 12 12M18 6 6 18"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20c.8-4 3.8-6 7.5-6s6.7 2 7.5 6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'arrow' -%}
      <path d="M4 12h16M14 6l6 6-6 6"/>
    {%- when 'chevron' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'play' -%}
      <path d="M8 5.5v13l11-6.5z" fill="currentColor"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/>
    {%- when 'mail' -%}
      <rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>
    {%- when 'message' -%}
      <path d="M4 5.5h16v10H10l-4.5 4v-4H4z"/>
    {%- when 'instagram' -%}
      <rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="16.8" cy="7.2" r=".6" fill="currentColor"/>
    {%- when 'tiktok' -%}
      <path d="M14 4v10.2a3.7 3.7 0 1 1-3.7-3.7"/><path d="M14 4c.4 2.4 2 4 4.5 4.2"/>
    {%- when 'facebook' -%}
      <path d="M14 20v-7.5h2.6l.5-3H14V7.7c0-.9.4-1.5 1.7-1.5h1.5V3.5c-.4 0-1.4-.2-2.5-.2-2.4 0-4 1.4-4 4.1v2.1H8v3h2.7V20z"/>
    {%- when 'pinterest' -%}
      <path d="M12 3.5a8.5 8.5 0 0 0-3.1 16.4c-.1-.7-.1-1.8 0-2.5l1-4.2s-.3-.5-.3-1.3c0-1.2.7-2.1 1.6-2.1.8 0 1.1.6 1.1 1.2 0 .8-.5 1.9-.7 2.9-.2.9.4 1.6 1.3 1.6 1.6 0 2.8-1.7 2.8-4.1 0-2.1-1.5-3.6-3.7-3.6-2.5 0-4 1.9-4 3.9 0 .8.3 1.6.7 2.1"/><path d="m10.1 15.6-.9 3.6"/>
    {%- when 'youtube' -%}
      <rect x="3" y="6" width="18" height="12" rx="3.5"/><path d="m10.5 9.5 4 2.5-4 2.5z" fill="currentColor"/>
  {%- endcase -%}
</svg>
